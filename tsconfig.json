{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "__data__", "__helpers__", "__tests__"]
}
